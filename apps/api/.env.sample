# Optional override: native API defaults to http://127.0.0.1:3435; Docker uses http://pocketbase:8090.
# POCKETBASE_URL=http://127.0.0.1:3435
POCKETBASE_SUPERUSER_EMAIL=admin@example.com
POCKETBASE_SUPERUSER_PASSWORD=change-me

# Native metrics listener; Compose binds it internally without publishing a port.
# Override METRICS_PORT when running multiple APIs directly on the same machine.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464

LOG_LEVEL=info
