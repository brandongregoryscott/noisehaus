{
    "extends": "tsconfig/base.json",
    "include": ["**/*.ts"],
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "paths": {
            "@/*": ["./src/*"]
        },
        "outDir": "dist"
    },
    "exclude": ["node_modules", "dist"]
}
