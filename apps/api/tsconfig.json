{
    "extends": "tsconfig/base.json",
    "include": ["**/*.ts"],
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "outDir": "dist"
    },
    "exclude": ["node_modules", "dist"]
}
